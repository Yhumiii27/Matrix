+
+// Une seule base par processus (survit au rechargement à chaud).
 const g = globalThis as unknown as { __vigieDb?: Promise<Db> };
 
-async function open(): Promise<Db> {
+// Applique drizzle/ sur le serveur commun. Même journal que le migrateur Drizzle (vigie.__drizzle_migrations),
+// sans son « CREATE SCHEMA IF NOT EXISTS » : vigie_app possède le schéma vigie mais n'a pas le droit CREATE sur la base.
+async function migrateServer(pool: Pool) {
+  const journal = `"${SCHEMA}"."${MIGRATIONS.migrationsTable}"`;
+  const client = await pool.connect();
+  try {
