# Proxy HTTPS du StarterPack : une adresse par outil (variables de .env). Keystone et Codex, sur leur jeu de démonstration
# au jalon A, sont fermés par l'authentification HTTP (generated/acces-demo.caddy, écrit par installer.sh). Clavis et
# Matrix ont leur propre connexion.
{
	# Pas de demande de certificat public : le serveur est interne.
	auto_https disable_redirects
}

(securite) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	encode zstd gzip
}

http:// {
	redir https://{host}{uri} permanent
}

{$CLAVIS_HOST} {
	tls {$EPC2I_TLS}
	import securite
	reverse_proxy clavis:3600
}

{$MATRIX_HOST} {
	tls {$EPC2I_TLS}
	import securite
	reverse_proxy matrix:3000
}

{$KEYSTONE_HOST} {
	tls {$EPC2I_TLS}
	import securite
	import /etc/caddy/generated/acces-demo.caddy
	reverse_proxy keystone:3000
}

{$CODEX_HOST} {
	tls {$EPC2I_TLS}
	import securite
	import /etc/caddy/generated/acces-demo.caddy
	reverse_proxy codex:3000
}
