+-- Droits de matrix_lecture sur le schéma cursus (exécuté par cursus_app après 0001).
+-- Ignoré si le rôle n'existe pas (PGlite, développement, tests).
+DO $$
+DECLARE
+  t text;
+  sensibles CONSTANT jsonb := '{
+    "employes": ["visite","passeport_numero","passeport_expire","naissance","reprise_motif"],
+    "vaccinations": ["v","date"],
+    "visas": ["type","obtenu","expire"],
+    "entretiens": ["cr"]
+  }';
+  cols text;
+BEGIN
+  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'matrix_lecture') THEN RETURN; END IF;
+  EXECUTE format('GRANT USAGE ON SCHEMA %I TO matrix_lecture', current_schema());
+  FOR t IN SELECT c.relname FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
+           WHERE n.nspname = current_schema() AND c.relkind IN ('r','v') LOOP
+    EXECUTE format('REVOKE ALL ON %I.%I FROM matrix_lecture', current_schema(), t);
+    IF sensibles ? t THEN
+      SELECT string_agg(quote_ident(a.attname), ', ' ORDER BY a.attnum) INTO cols
+      FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid JOIN pg_namespace n ON n.oid = c.relnamespace
+      WHERE n.nspname = current_schema() AND c.relname = t AND a.attnum > 0 AND NOT a.attisdropped
+        AND NOT (sensibles -> t) ? a.attname;
+      EXECUTE format('GRANT SELECT (%s) ON %I.%I TO matrix_lecture', cols, current_schema(), t);
+    ELSE
+      EXECUTE format('GRANT SELECT ON %I.%I TO matrix_lecture', current_schema(), t);
+    END IF;
+  END LOOP;
+END $$;
