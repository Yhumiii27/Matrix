# Matrix — variables d'environnement (REGLES § 9 de Norma). Aucune valeur secrète ici : sur le serveur interne, le fichier
# réel est /etc/atrium/matrix.env (docs/installation-directe.md). Détail de chaque variable : en-tête de serveur.mjs.
# Toutes sont lues et contrôlées au démarrage par outils/config.mjs (type, bornes, défaut) : une valeur invalide arrête
# Matrix, une ligne par erreur. Une variable vide vaut sa valeur par défaut ; une configuration incomplète (Entra ID,
# alertes) est seulement signalée.

# Port d'écoute, entier de 1 à 65535 (défaut 3700, port de Matrix au registre de Norma ; l'image Docker pose 3000).
PORT=3700
# vide, development, production ou test ; production : modifications refusées sans accès réservé (mot de passe ou
# connexion nominative).
NODE_ENV=
# Données vivantes : catalogue, historique, déclarations (défaut ./data).
MATRIX_DATA_DIR=
# Dossier des déclarations lues par le collecteur en ligne de commande, npm run collecter (défaut ./declarations).
MATRIX_DECLARATIONS_DIR=
# Dossier qui contient les dépôts keystone/, codex/, cursus/, vigie/, arche/, crucible/ (facultatif ; doit exister).
MATRIX_SOURCES_DIR=
# Jeton partagé avec les outils pour leurs déclarations (sans lui : déclarations refusées).
MATRIX_TOKEN=
# Mot de passe de Matrix (page /connexion, en-tête Basic des scripts).
MATRIX_MOT_DE_PASSE=

# Serveur PostgreSQL commun (postgres://rôle:mot de passe@hôte:5432/atrium) : rôle matrix_app (sonde, référentiels,
# liens), rôle matrix_gestion (publications, M-18 ; exige aussi MATRIX_DATABASE_URL).
MATRIX_DATABASE_URL=
MATRIX_GESTION_DATABASE_URL=
# Minutes entre deux lectures du serveur commun, de 0 à 1440 (défaut 60 ; 0 : au démarrage et à la demande).
MATRIX_SYNCHRO_MINUTES=

# Connexion nominative (OpenID Connect : Clavis, ou Microsoft Entra ID). Adresses en https:// (http:// pour localhost
# seulement) ; MATRIX_SESSION_SECRET : 32 caractères au moins.
MATRIX_PUBLIC_URL=
MATRIX_SESSION_SECRET=
MATRIX_ENTRA_TENANT_ID=
MATRIX_ENTRA_CLIENT_ID=
MATRIX_ENTRA_CLIENT_SECRET=
# Émetteur : l'adresse de Clavis (variable du registre de Norma), sinon Entra ID d'après le locataire.
MATRIX_ENTRA_ISSUER=
# Rôles applicatifs (défauts Matrix.Administrateur, Matrix.Lecture).
MATRIX_ENTRA_ROLE_ADMIN=
MATRIX_ENTRA_ROLE_LECTURE=
# on, off ou vide ; on : le rôle est lu dans clavis.pub_acces (exige MATRIX_DATABASE_URL et une connexion complète),
# relu au plus toutes les N secondes, de 0 à 60 (défaut 60 ; Norma § 6 : au plus chaque minute).
MATRIX_ACCES_CLAVIS=
MATRIX_ACCES_CLAVIS_SECONDES=

# Alertes de la DSI par e-mail (Microsoft Graph) : adresses séparées par des virgules ; URL en https://.
MATRIX_ALERTES_DESTINATAIRES=
MATRIX_ALERTES_EXPEDITEUR=
MATRIX_ALERTES_LOGIN_URL=
MATRIX_ALERTES_GRAPH_URL=
