+// ── PostgreSQL : serveur (pg) ou embarqué (PGlite) ───────────────────────
+const MIGRATIONS_DIR = join(dirname(fileURLToPath(import.meta.url)), '..', 'migrations-pg');
+const AUTO_TABLES = (Object.entries(TABLES) as [TableName, TableDef][]).filter(([, d]) => d.auto).map(([n]) => snake(n));
+
+abstract class PgBase extends Db {
+  readonly dialect = 'pg' as const;
+  async init() {
+    // Journal des migrations dans le schéma de l'outil (jamais dans un schéma partagé).
+    await this.query(`CREATE TABLE IF NOT EXISTS schema_migrations (nom text PRIMARY KEY, appliquee_le timestamptz NOT NULL DEFAULT now())`);
+    await this.tx(async () => {
+      await this.query(`SELECT pg_advisory_xact_lock(hashtext('cursus.migrations'))`);
+      const faites = new Set((await this.query<{ nom: string }>('SELECT nom FROM schema_migrations')).map(r => r.nom));
+      for (const f of readdirSync(MIGRATIONS_DIR).filter(f => f.endsWith('.sql')).sort()) {
+        if (faites.has(f)) continue;
+        await this.execScript(readFileSync(join(MIGRATIONS_DIR, f), 'utf8'));
+        await this.query('INSERT INTO schema_migrations (nom) VALUES ($1)', [f]);
+      }
+    });
+  }
+  protected abstract execScript(sql: string): Promise<void>;
+  async columns(table: TableName) {
+    return (await this.query<{ column_name: string }>(`SELECT column_name FROM information_schema.columns WHERE table_schema = current_schema() AND table_name = $1 ORDER BY ordinal_position`, [snake(table)])).map(r => r.column_name);
+  }
+  async clearAll() {
+    await this.query(`TRUNCATE ${Object.keys(TABLES).map(snake).join(', ')} RESTART IDENTITY CASCADE`);
+  }
+  async resyncIds() {
+    for (const t of AUTO_TABLES) {
+      await this.query(`SELECT setval(pg_get_serial_sequence($1, 'id'), COALESCE((SELECT max(id) FROM ${t}), 0) + 1, false)`, [t]);
+    }
+  }
+  async lockActions() { await this.query(`SELECT pg_advisory_xact_lock(hashtext('cursus.actions'))`); }
+}
+
+export class PgDb extends PgBase {
+  private pool: any;
+  constructor(pool: any) { super(); this.pool = pool; }
+  static async connect(url: string, schema?: string) {
+    const pg = (await import('pg')).default;
+    pg.types.setTypeParser(1082, (v: string) => v);          // date → 'AAAA-MM-JJ' (le domaine compare des chaînes)
+    pg.types.setTypeParser(1700, (v: string) => Number(v));  // numeric → nombre
+    pg.types.setTypeParser(20, (v: string) => Number(v));    // bigint (COUNT) → nombre
+    const pool = new pg.Pool({ connectionString: url, max: Number(process.env.CURSUS_PG_POOL || 10), ...(schema ? { options: `-c search_path=${schema}` } : {}) });
+    return new PgDb(pool);
+  }
+  protected base(): Exec { return { query: async (s, p) => (await this.pool.query(s, p)).rows }; }
+  protected async withTx<T>(fn: (x: Exec) => Promise<T>): Promise<T> {
+    const client = await this.pool.connect();
+    try {
+      await client.query('BEGIN');
+      const r = await fn({ query: async (s, p) => (await client.query(s, p)).rows });
+      await client.query('COMMIT');
+      return r;
+    } catch (e) {
+      await client.query('ROLLBACK').catch(() => {});
+      throw e;
+    } finally { client.release(); }
+  }
+  protected async execScript(sql: string) { await this.query(sql); }
+  async close() { await this.pool.end(); }
+}
+
+const PGLITE_PARSERS = { 1082: (v: string) => v, 1700: (v: string) => Number(v), 20: (v: string) => Number(v) };
+
+export class PgliteDb extends PgBase {
+  private pg: any;
+  private mutex = new Mutex();
+  private direct: Exec;
+  constructor(pg: any) {
+    super();
+    this.pg = pg;
+    this.direct = { query: async (s, p) => (await this.pg.query(s, p, { parsers: PGLITE_PARSERS })).rows };
+  }
+  static async open(dir?: string) {
+    const { PGlite } = await import('@electric-sql/pglite');
+    if (dir) mkdirSync(dir, { recursive: true });
+    const pg = new PGlite(dir); // les parseurs se passent à chaque requête (option du constructeur ignorée en 0.5.x)
+    await pg.waitReady;
+    // Même organisation que le serveur commun : schéma cursus.
+    await pg.exec(`CREATE SCHEMA IF NOT EXISTS cursus; SET search_path = cursus;`);
+    return new PgliteDb(pg);
+  }
+  protected base(): Exec { return { query: (s, p) => this.mutex.run(() => this.direct.query(s, p)) }; }
+  protected withTx<T>(fn: (x: Exec) => Promise<T>): Promise<T> {
+    return this.mutex.run(async () => {
+      await this.pg.query('BEGIN');
+      try { const r = await fn(this.direct); await this.pg.query('COMMIT'); return r; } catch (e) { await this.pg.query('ROLLBACK'); throw e; }
+    });
+  }
+  protected async execScript(sql: string) { await this.pg.exec(sql); }
+  async close() { await this.pg.close(); }
+}
