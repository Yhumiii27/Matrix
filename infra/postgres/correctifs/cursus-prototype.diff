+ */
+export async function openTestDb(): Promise<Db> {
+  const engine = process.env.CURSUS_TEST_ENGINE || 'sqlite';
+  let db: Db;
+  if (engine === 'pglite') db = await PgliteDb.open();
+  else if (engine === 'pg') {
+    const schema = `cursus_t${process.pid}_${Math.random().toString(36).slice(2, 8)}`;
+    const admin = await PgDb.connect(process.env.CURSUS_TEST_PG_URL!);
+    await admin.query(`CREATE SCHEMA ${schema}`);
+    await admin.close();
+    db = await PgDb.connect(process.env.CURSUS_TEST_PG_URL!, schema);
+  } else db = new SqliteDb(':memory:');
+  await db.init();
+  return db;
 }
