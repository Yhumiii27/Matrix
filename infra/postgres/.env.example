# Variables du serveur PostgreSQL commun de la suite Atrium (docker-compose.yml).
# En local : copier ce fichier en .env (jamais versionné) et remplir chaque valeur.
# Dans Coolify : saisir les mêmes variables dans la ressource.
# Un mot de passe solide : openssl rand -base64 30 | tr -d '/+=' | cut -c1-32

# Superutilisateur postgres (administration seulement).
POSTGRES_PASSWORD=

# Rôles de connexion des outils (init/01-base-et-roles.sql). Chaque outil reçoit le sien dans DATABASE_URL.
KEYSTONE_APP_PASSWORD=
CODEX_APP_PASSWORD=
CURSUS_APP_PASSWORD=
VIGIE_APP_PASSWORD=
ARCHE_APP_PASSWORD=
CRUCIBLE_APP_PASSWORD=
MATRIX_APP_PASSWORD=
# Matrix, administration des publications et des liens (décision M-18) : rôle matrix_gestion.
MATRIX_GESTION_PASSWORD=
# Power BI, lecture seule des vues pub_ accordées (demande M-14 d'Arche) : rôle bi_reader. Facultatif : vide, le rôle ne
# peut pas se connecter.
BI_READER_PASSWORD=
# Clavis (annuaire et accès aux outils) : rôle clavis_app. Facultatif : vide, le rôle ne peut pas se connecter.
CLAVIS_APP_PASSWORD=
# Modulus (commercial et chiffrage) : rôle modulus_app. Facultatif : vide, le rôle ne peut pas se connecter.
MODULUS_APP_PASSWORD=
# Vector (expéditions nationales et internationales) : rôle vector_app. Facultatif : vide, le rôle ne peut pas se connecter.
VECTOR_APP_PASSWORD=
# Purge du journal des actions de Cursus (décision M-24) : rôle cursus_purge, seul à supprimer les lignes échues du
# journal. Facultatif : vide, le rôle ne peut pas se connecter et la purge de Cursus reste désactivée. Cursus le reçoit
# dans CURSUS_PURGE_DATABASE_URL (jamais dans DATABASE_URL).
CURSUS_PURGE_PASSWORD=

# Rôle des sauvegardes atrium_sauvegarde (pg_dump, lecture de toutes les données, colonnes sensibles comprises).
# Sur un serveur installé avant le renommage en Atrium, l'ancienne variable EPC2I_SAUVEGARDE_PASSWORD est acceptée à
# sa place jusqu'au nettoyage de docs/renommage-atrium.md (même valeur ; l'une des deux doit être remplie).
ATRIUM_SAUVEGARDE_PASSWORD=

# Facultatif : port local publié (127.0.0.1) et rétention des sauvegardes en jours.
# ATRIUM_PG_PORT=5432
# ATRIUM_SAUVEGARDE_JOURS=14
