@@ -0,0 +1,22 @@
+// vitest globalSetup: builds the seeded test database once per run and dumps it; openDatabase() in the test files
+// then loads a private in-memory copy of it (src/server/db/open.ts, KEYSTONE_TEST_DB_TEMPLATE).
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { PGlite } from '@electric-sql/pglite';
+import { drizzle } from 'drizzle-orm/pglite';
+import { migrateKeystone } from '@/server/db/migrate';
+import * as schema from '@/server/db/schema';
+import { seedIfEmpty } from '@/server/db/seed';
+
+export default async function setup(): Promise<() => void> {
+  const client = await PGlite.create();
+  const db = drizzle(client, { schema });
+  await migrateKeystone(db, path.join(process.cwd(), 'drizzle'), { createSchema: true });
+  await seedIfEmpty(db);
+  const file = path.join(os.tmpdir(), `keystone-test-db-${process.pid}.tar`);
+  fs.writeFileSync(file, Buffer.from(await (await client.dumpDataDir('none')).arrayBuffer()));
+  await client.close();
+  process.env.KEYSTONE_TEST_DB_TEMPLATE = file;
+  return () => fs.rmSync(file, { force: true });
+}
