+
+/**
+ * Connects to the shared EPC2i PostgreSQL server (`url`, e.g. postgres://keystone_app:…@host:5432/epc2i) as keystone_app:
+ * every connection gets search_path = keystone, migrations go to keystone.__drizzle_migrations. The role owns the
+ * keystone schema and nothing else.
+ */
+export async function openServerDatabase(url: string, opts: ServerDatabaseOptions = {}): Promise<DB> {
+  const pool = new Pool({
+    connectionString: url,
+    max: opts.max ?? 10,
+    application_name: 'keystone',
+    options: `-c search_path=${DB_SCHEMA}`,
+  });
+  pool.on('error', (e) => console.error('[db] idle client error:', e));
+  const db: DB = serializeTransactions(drizzlePg(pool, { schema }));
+  await migrateKeystone(db, opts.migrationsFolder ?? MIGRATIONS);
+  if (opts.seed) await seedIfEmpty(db);
+  return db;
+}
+
+/** Advisory lock taken by every Keystone transaction on the server (key "KS" + 2). */
+const WRITE_LOCK = 0x4b53_0002;
+
+/**
+ * Makes db.transaction() take one transaction-scoped advisory lock first: Keystone transactions run one at a time, as
+ * they do on PGlite (single connection). The DAL computes business numbers (R-21, CR-011…) and positions as max + 1
+ * inside its transactions; without the lock, concurrent writes collide on the unique keys. Reads outside transactions
+ * stay concurrent.
+ */
+function serializeTransactions(db: DB): DB {
+  const transaction = db.transaction.bind(db);
+  db.transaction = ((fn, config) =>
+    transaction(async (tx) => {
+      await tx.execute(sql`select pg_advisory_xact_lock(${WRITE_LOCK})`);
+      return fn(tx);
+    }, config)) as DB['transaction'];
+  return db;
+}
