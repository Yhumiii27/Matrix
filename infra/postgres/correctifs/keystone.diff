+
+export interface ServerDatabaseOptions {
+  migrationsFolder?: string;
+  /** Seeds the prototype data set when the projects table is empty (demo and beta servers only). */
+  seed?: boolean;
+  /** Pool size (KEYSTONE_DB_POOL_MAX, default 10). */
+  max?: number;
