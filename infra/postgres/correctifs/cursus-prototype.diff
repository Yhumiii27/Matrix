+/** Choix du moteur : DATABASE_URL → serveur commun ; sinon PGlite ou SQLite local. */
+export async function openDb(file = process.env.CURSUS_DB || 'data/cursus.db'): Promise<Db> {
+  let db: Db;
+  if (process.env.DATABASE_URL) db = await PgDb.connect(process.env.DATABASE_URL, process.env.CURSUS_PG_SCHEMA);
+  else if (process.env.CURSUS_DB_ENGINE === 'pglite') db = await PgliteDb.open(file === ':memory:' ? undefined : file.replace(/\.db$/, '-pglite'));
+  else db = new SqliteDb(file);
+  await db.init();
+  return db;
+}
