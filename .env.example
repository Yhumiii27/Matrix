# Matrix — variables d'environnement (REGLES § 9 de Norma). Aucune valeur secrète ici : sur le serveur interne, le fichier
# réel est /etc/epc2i/matrix.env (docs/installation-directe.md). Détail de chaque variable : en-tête de serveur.mjs.

# Port d'écoute (défaut 3700, port de Matrix au registre de Norma ; l'image Docker pose 3000).
PORT=3700
# production : les modifications sont refusées sans accès réservé (mot de passe ou connexion nominative).
NODE_ENV=
# Données vivantes : catalogue, historique, déclarations (défaut ./data).
MATRIX_DATA_DIR=
# Dossier des déclarations lues par le collecteur (défaut ./declarations).
MATRIX_DECLARATIONS_DIR=
# Dossier qui contient les dépôts keystone/, codex/, cursus/, vigie/, arche/, crucible/ (facultatif).
MATRIX_SOURCES_DIR=
# Jeton partagé avec les outils pour leurs déclarations (sans lui : déclarations refusées).
MATRIX_TOKEN=
# Mot de passe de Matrix (page /connexion, en-tête Basic des scripts).
MATRIX_MOT_DE_PASSE=

# Serveur PostgreSQL commun : rôle matrix_app (sonde, référentiels, liens), rôle matrix_gestion (publications, M-18).
MATRIX_DATABASE_URL=
MATRIX_GESTION_DATABASE_URL=
# Minutes entre deux lectures du serveur commun (défaut 60 ; 0 : au démarrage et à la demande).
MATRIX_SYNCHRO_MINUTES=

# Connexion nominative (OpenID Connect : Clavis, ou Microsoft Entra ID).
MATRIX_PUBLIC_URL=
MATRIX_SESSION_SECRET=
MATRIX_ENTRA_TENANT_ID=
MATRIX_ENTRA_CLIENT_ID=
MATRIX_ENTRA_CLIENT_SECRET=
# Émetteur : l'adresse de Clavis (variable du registre de Norma), sinon Entra ID d'après le locataire.
MATRIX_ENTRA_ISSUER=
# Rôles applicatifs (défauts Matrix.Administrateur, Matrix.Lecture).
MATRIX_ENTRA_ROLE_ADMIN=
MATRIX_ENTRA_ROLE_LECTURE=
# on : le rôle est lu dans clavis.pub_acces (MATRIX_DATABASE_URL), relu au plus toutes les N secondes (défaut 60).
MATRIX_ACCES_CLAVIS=
MATRIX_ACCES_CLAVIS_SECONDES=

# Alertes de la DSI par e-mail (Microsoft Graph).
MATRIX_ALERTES_DESTINATAIRES=
MATRIX_ALERTES_EXPEDITEUR=
MATRIX_ALERTES_LOGIN_URL=
MATRIX_ALERTES_GRAPH_URL=
