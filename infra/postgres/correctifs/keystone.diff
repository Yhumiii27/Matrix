--- a/src/server/db/migrate.ts
+++ b/src/server/db/migrate.ts
@@ -0,0 +1,33 @@
+import 'server-only';
+import { sql } from 'drizzle-orm';
+import { readMigrationFiles } from 'drizzle-orm/migrator';
+import type { DB } from './types';
+
+/** Postgres schema holding every Keystone table and the migration journal (shared EPC2i server: one schema per app). */
+export const DB_SCHEMA = 'keystone';
+const JOURNAL = sql.identifier('__drizzle_migrations');
+const SCHEMA = sql.identifier(DB_SCHEMA);
+/** Advisory lock key: two Keystone instances starting together never apply the same migration twice. */
+const LOCK_KEY = 0x4b53_0001;
+
+/**
+ * Applies the migrations of `migrationsFolder` not yet in keystone.__drizzle_migrations, in one transaction.
+ * Same bookkeeping as drizzle-orm's migrate() with migrationsSchema 'keystone' (journal table, hash, created_at), without
+ * its `CREATE SCHEMA IF NOT EXISTS`: on the shared server keystone_app owns the schema but may not create schemas
+ * (Postgres checks the database CREATE right before it looks for the schema). `createSchema` is for PGlite only.
+ */
+export async function migrateKeystone(db: DB, migrationsFolder: string, { createSchema = false } = {}): Promise<void> {
+  const migrations = readMigrationFiles({ migrationsFolder });
+  if (createSchema) await db.execute(sql`create schema if not exists ${SCHEMA}`);
+  await db.transaction(async (tx) => {
+    await tx.execute(sql`select pg_advisory_xact_lock(${LOCK_KEY})`);
+    await tx.execute(sql`create table if not exists ${SCHEMA}.${JOURNAL} (id serial primary key, hash text not null, created_at bigint)`);
+    const { rows } = await tx.execute<{ created_at: string | number }>(sql`select created_at from ${SCHEMA}.${JOURNAL} order by created_at desc limit 1`);
+    const last = rows[0] ? Number(rows[0].created_at) : -1;
+    for (const m of migrations) {
+      if (m.folderMillis <= last) continue;
+      for (const stmt of m.sql) if (stmt.trim()) await tx.execute(sql.raw(stmt));
+      await tx.execute(sql`insert into ${SCHEMA}.${JOURNAL} (hash, created_at) values (${m.hash}, ${m.folderMillis})`);
+    }
+  });
+}
