+// Reprise d'une base SQLite de Cursus dans PostgreSQL (schéma cursus).
+//
+//   DATABASE_URL=postgres://cursus_app:…@serveur/epc2i \
+//   node server/scripts/sqlite-vers-postgres.ts --sqlite /data/cursus.db [--verifier] [--remplacer]
+//
+// --verifier   contrôle la base source et s'arrête (aucune écriture dans PostgreSQL).
+// --remplacer  vide le schéma cible s'il contient déjà des données (sinon refus).
+//
+// Étapes : copie de sauvegarde → mise à niveau de la copie (colonnes, anciens contrats) → contrôles
+// (dates, JSON, 37 liens) → création du schéma (migrations) → copie table par table en une transaction,
+// identifiants conservés (matricule EMP-xxxx) → recalage des séquences → comparaison des instantanés.
+import { copyFileSync, existsSync } from 'node:fs';
+import { isDeepStrictEqual } from 'node:util';
+import { PgDb, SqliteDb, TABLES, snake, type TableName } from '../src/db.ts';
+import { migrate } from '../src/migrate.ts';
+import { loadFull } from '../src/dataset.ts';
+
+const args = process.argv.slice(2);
+const opt = (n: string) => args.includes(n);
+const fichier = args[args.indexOf('--sqlite') + 1];
+if (!fichier || !existsSync(fichier)) throw new Error('Indiquez la base source : --sqlite chemin/cursus.db');
+if (!opt('--verifier') && !process.env.DATABASE_URL) throw new Error('DATABASE_URL manquant');
+
+// Ordre d'insertion compatible avec les clés étrangères (equipes.manager_id est différée).
+const ORDRE: TableName[] = ['formations', 'habilitations', 'destinations', 'projets', 'chantiers', 'equipes', 'employes', 'soldesReprise',
+  'sessions', 'certifications', 'habTitres', 'visas', 'vaccinations', 'inscriptions', 'planActions', 'budgets', 'voyages', 'demandesKeystone',
+  'missions', 'taches', 'feuilles', 'absences', 'cet', 'reports', 'entretiens', 'demandesCollab', 'settings', 'journal'];
+const AVEC_RANG = new Set<TableName>(['formations', 'habilitations', 'destinations', 'projets']);
+const LIENS: [TableName, string, TableName, string][] = [
+  ['absences', 'empId', 'employes', 'id'], ['budgets', 'equipe', 'equipes', 'nom'], ['certifications', 'empId', 'employes', 'id'], ['certifications', 'f', 'formations', 'id'],
+  ['certifications', 'sessionId', 'sessions', 'id'], ['cet', 'empId', 'employes', 'id'], ['demandesCollab', 'empId', 'employes', 'id'], ['demandesCollab', 'f', 'formations', 'id'],
+  ['demandesCollab', 'h', 'habilitations', 'id'], ['demandesCollab', 'sessionId', 'sessions', 'id'], ['demandesCollab', 'parId', 'employes', 'id'], ['demandesKeystone', 'empId', 'employes', 'id'],
+  ['demandesKeystone', 'chantier', 'chantiers', 'id'], ['demandesKeystone', 'dest', 'destinations', 'code'], ['employes', 'equipe', 'equipes', 'nom'], ['entretiens', 'empId', 'employes', 'id'],
+  ['equipes', 'managerId', 'employes', 'id'], ['feuilles', 'empId', 'employes', 'id'], ['habTitres', 'empId', 'employes', 'id'], ['habTitres', 'h', 'habilitations', 'id'],
+  ['inscriptions', 'empId', 'employes', 'id'], ['inscriptions', 'sessionId', 'sessions', 'id'], ['missions', 'empId', 'employes', 'id'], ['missions', 'projet', 'projets', 'code'],
+  ['planActions', 'f', 'formations', 'id'], ['planActions', 'equipe', 'equipes', 'nom'], ['reports', 'empId', 'employes', 'id'], ['sessions', 'formation', 'formations', 'id'],
+  ['soldesReprise', 'empId', 'employes', 'id'], ['taches', 'empId', 'employes', 'id'], ['taches', 'projet', 'projets', 'code'], ['vaccinations', 'empId', 'employes', 'id'],
+  ['visas', 'empId', 'employes', 'id'], ['visas', 'dest', 'destinations', 'code'], ['voyages', 'empId', 'employes', 'id'], ['voyages', 'dest', 'destinations', 'code'], ['voyages', 'chantier', 'chantiers', 'id'],
+];
+const DATES: Record<string, string[]> = {
+  chantiers: ['debut', 'fin'], employes: ['tempsDepuis', 'entree', 'fin', 'repriseDate', 'visite', 'passeportExpire'], certifications: ['obtenue'],
+  habTitres: ['delivree', 'demande'], visas: ['obtenu', 'expire'], vaccinations: ['date'], sessions: ['date'], inscriptions: ['date'], voyages: ['depart', 'retour'],
+  demandesKeystone: ['depart', 'retour', 'recue'], missions: ['du', 'au'], feuilles: ['week'], absences: ['du', 'au'], cet: ['date'], reports: ['date'],
+  entretiens: ['date', 'signSal', 'signMgr'], demandesCollab: ['date'],
+};
+const ISO = /^\d{4}-\d{2}-\d{2}$/;
+
+// 1. Copie de sauvegarde, puis mise à niveau de la copie avec le code de Cursus (colonnes manquantes, anciens contrats).
+const copie = `${fichier}.avant-postgres-${new Date().toISOString().replace(/[:.]/g, '-')}`;
+copyFileSync(fichier, copie);
+for (const suffixe of ['-wal', '-shm']) if (existsSync(fichier + suffixe)) copyFileSync(fichier + suffixe, copie + suffixe);
+const src = new SqliteDb(copie);
+await src.init();
+await migrate(src);
+
+// 2. Lecture brute (avec rowid) et décodage par l'interface commune.
+const lignes = new Map<TableName, { rowid: number; o: Record<string, unknown> }[]>();
+const erreurs: string[] = [];
+for (const t of ORDRE) {
+  const raw = src.sql.prepare(`SELECT rowid AS __rowid, * FROM ${snake(t)} ORDER BY rowid`).all() as Record<string, unknown>[];
+  const def = TABLES[t] as { cols: Record<string, string> };
+  const enTrop = Object.keys(raw[0] ?? {}).filter(c => c !== '__rowid' && !Object.keys(def.cols).map(snake).includes(c));
+  if (enTrop.length) console.log(`  ${snake(t)} : colonnes historiques non reprises : ${enTrop.join(', ')}`);
+  lignes.set(t, raw.map(r => {
+    let o: Record<string, unknown>;
+    try { o = src.decode(t, r); } catch (e) { erreurs.push(`${snake(t)} rowid ${r.__rowid} : JSON illisible (${(e as Error).message})`); o = {}; }
+    for (const c of DATES[t] ?? []) {
+      if (o[c] === '') o[c] = null;                       // chaîne vide → NULL
+      if (o[c] != null && !(ISO.test(String(o[c])) && !Number.isNaN(Date.parse(String(o[c]))))) erreurs.push(`${snake(t)} rowid ${r.__rowid} : date invalide ${snake(c)} = ${JSON.stringify(o[c])}`);
+    }
+    return { rowid: Number(r.__rowid), o };
+  }));
+}
+for (const [t, c, rt, rc] of LIENS) {
+  const cibles = new Set(lignes.get(rt)!.map(x => x.o[rc]));
+  for (const { rowid, o } of lignes.get(t)!) if (o[c] != null && !cibles.has(o[c])) erreurs.push(`${snake(t)} rowid ${rowid} : ${snake(c)} = ${JSON.stringify(o[c])} absent de ${snake(rt)}.${snake(rc)}`);
+}
+for (const t of ORDRE) console.log(`  ${snake(t).padEnd(18)} ${String(lignes.get(t)!.length).padStart(6)} lignes`);
+if (erreurs.length) {
+  console.error(`\n${erreurs.length} anomalie(s) à corriger dans la source avant reprise :\n- ${erreurs.slice(0, 50).join('\n- ')}`);
+  process.exit(1);
+}
+console.log('Contrôles de la source : aucune anomalie (dates, JSON, 37 liens).');
+if (opt('--verifier')) process.exit(0);
+
+// 3. Cible : migrations, refus si des données existent déjà (sauf --remplacer).
+const pg = await PgDb.connect(process.env.DATABASE_URL!, process.env.CURSUS_PG_SCHEMA);
+await pg.init();
+const dejaPleine = [];
+for (const t of ORDRE) if ((await pg.count(t)) > 0) dejaPleine.push(snake(t));
+if (dejaPleine.length && !opt('--remplacer')) {
+  console.error(`Le schéma cible contient déjà des données (${dejaPleine.join(', ')}). Relancez avec --remplacer pour les écraser.`);
+  process.exit(1);
+}
+
+// 4. Copie en une transaction : tout ou rien.
+const t0 = performance.now();
+await pg.tx(async () => {
+  await pg.query('SET CONSTRAINTS ALL DEFERRED');
+  if (dejaPleine.length) await pg.clearAll();
+  for (const t of ORDRE) {
+    const def = TABLES[t] as { pk: string; auto?: boolean; cols: Record<string, string> };
+    const cols = Object.keys(def.cols);
+    const noms = [...cols.map(snake), ...(AVEC_RANG.has(t) ? ['rang'] : [])];
+    const rows = lignes.get(t)!;
+    for (let i = 0; i < rows.length; i += 500) {
+      const lot = rows.slice(i, i + 500), params: unknown[] = [];
+      const valeurs = lot.map(({ rowid, o }) => {
+        const v = cols.map(c => (pg as any).toDb(def.cols[c], o[c]));
