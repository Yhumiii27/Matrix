+/** Base Vigie, quel que soit le pilote (serveur PostgreSQL commun ou PGlite embarqué). */
+export type Db = PgDatabase<PgQueryResultHKT, typeof schema>;
 
-// Une seule instance PGlite par processus (survit au rechargement à chaud).
+// Schéma PostgreSQL de Vigie : ses tables et le journal de ses migrations (jamais le schéma « drizzle » partagé).
+const SCHEMA = 'vigie';
+const MIGRATIONS = {
+  migrationsFolder: path.join(process.cwd(), 'drizzle'),
+  migrationsSchema: SCHEMA,
+  migrationsTable: '__drizzle_migrations',
