+-- Cursus : schéma PostgreSQL cible (migration 0001). Exécutée par cursus_app, search_path = cursus.
+-- Noms de tables et de colonnes inchangés par rapport à SQLite (snake_case de server/src/db.ts).
+
+-- ── Référentiels ─────────────────────────────────────────────────────────
+CREATE TABLE formations (
+  id         text PRIMARY KEY,
+  rang       integer GENERATED BY DEFAULT AS IDENTITY,  -- remplace l'ordre rowid de SQLite
+  nom        text NOT NULL,
+  court      text,
+  type       text,
+  validite   integer,            -- mois
+  duree      text,
+  organisme  text,
+  cout       numeric(12,2)
+);
+CREATE TABLE habilitations (
+  id          text PRIMARY KEY,
+  rang        integer GENERATED BY DEFAULT AS IDENTITY,
+  nom         text NOT NULL,
+  detail      text,
+  prereqs     jsonb NOT NULL DEFAULT '[]' CHECK (jsonb_typeof(prereqs) = 'array'),  -- ids de formations
+  medical     boolean NOT NULL DEFAULT false,
+  validite    integer,
+  signataire  text
+);
+CREATE TABLE destinations (
+  code       text PRIMARY KEY,
+  rang       integer GENERATED BY DEFAULT AS IDENTITY,
+  pays       text NOT NULL,
+  visa       text,
+  visa_sub   text,
+  oblig      jsonb NOT NULL DEFAULT '[]' CHECK (jsonb_typeof(oblig) = 'array'),   -- ids de vaccins (constante VACCINS)
+  rec        jsonb NOT NULL DEFAULT '[]' CHECK (jsonb_typeof(rec) = 'array'),
+  pass_mois  integer
+);
+CREATE TABLE projets (
+  code  text PRIMARY KEY,
+  rang  integer GENERATED BY DEFAULT AS IDENTITY,
+  nom   text
+);
+CREATE TABLE chantiers (
+  id          text PRIMARY KEY,
+  nom         text,
+  client      text,
+  lieu        text,
+  pays        text,              -- code destination, ou 'FR' (pas de clé étrangère)
+  debut       date,
+  fin         date,
+  chef        text,
+  habs        jsonb NOT NULL DEFAULT '[]' CHECK (jsonb_typeof(habs) = 'array'),        -- ids d'habilitations
+  certs       jsonb NOT NULL DEFAULT '[]' CHECK (jsonb_typeof(certs) = 'array'),       -- ids de formations
+  ressources  jsonb NOT NULL DEFAULT '[]' CHECK (jsonb_typeof(ressources) = 'array')   -- ids d'employés
+);
+
+-- ── Personnel ───────────────────────────────────────────────────────────
+CREATE TABLE equipes (
+  nom         text PRIMARY KEY,
+  manager_id  integer,           -- clé étrangère ajoutée après employes
+  ordre       integer NOT NULL DEFAULT 0
+);
+CREATE TABLE employes (
+  id                integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,  -- matricule EMP-xxxx dérivé de l'id
+  nom               text NOT NULL,
+  equipe            text REFERENCES equipes (nom) ON UPDATE CASCADE ON DELETE RESTRICT,
+  poste             text,
+  statut            text,
+  type_contrat      text,
+  temps             text,
+  heures            numeric,
+  forfait_heures    numeric,
+  forfait_jours     numeric,
+  jour_off          jsonb NOT NULL DEFAULT '[]' CHECK (jsonb_typeof(jour_off) = 'array'),
+  temps_depuis      date,
+  entree            date,
+  fin               date,
+  naissance         integer,       -- sensible
+  agence            text,
+  reprise_motif     text,          -- sensible
+  reprise_date      date,
+  visite            date,          -- sensible (santé)
+  passeport_numero  text,          -- sensible
+  passeport_expire  date,          -- sensible
+  -- Identifiant partagé avec Keystone, Vigie, Codex et Sage (D01) ; même règle que shared/format.ts (padStart, sans troncature).
+  matricule         text GENERATED ALWAYS AS ('EMP-' || CASE WHEN id < 10000 THEN lpad(id::text, 4, '0') ELSE id::text END) STORED UNIQUE
+);
+ALTER TABLE equipes ADD CONSTRAINT equipes_manager_id_fkey
+  FOREIGN KEY (manager_id) REFERENCES employes (id) ON DELETE SET NULL DEFERRABLE INITIALLY DEFERRED;
+
+CREATE TABLE soldes_reprise (
+  emp_id        integer PRIMARY KEY REFERENCES employes (id) ON DELETE CASCADE,
+  cp_pris       numeric NOT NULL DEFAULT 0,
+  rtt_pris      numeric NOT NULL DEFAULT 0,
+  recup_acquis  numeric NOT NULL DEFAULT 0,
+  recup_pris    numeric NOT NULL DEFAULT 0
+);
+
+-- ── Formation & conformité ──────────────────────────────────────────────
+CREATE TABLE sessions (
+  id         integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,  -- ids explicites dans seed.ts
+  formation  text NOT NULL REFERENCES formations (id) ON UPDATE CASCADE ON DELETE RESTRICT,
+  date       date NOT NULL,
+  lieu       text,
+  places     integer NOT NULL DEFAULT 0,
+  inscrits   integer NOT NULL DEFAULT 0,
+  statut     text
+);
+CREATE TABLE certifications (
+  id          integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id      integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  f           text NOT NULL REFERENCES formations (id) ON UPDATE CASCADE ON DELETE RESTRICT,
+  obtenue     date,
+  session_id  integer REFERENCES sessions (id) ON DELETE SET NULL,
+  convoc      text
+);
+CREATE TABLE hab_titres (
+  id        integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id    integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  h         text NOT NULL REFERENCES habilitations (id) ON UPDATE CASCADE ON DELETE RESTRICT,
+  delivree  date,
+  par       text,
+  demande   date
+);
+CREATE TABLE visas (
+  id      integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id  integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  dest    text NOT NULL REFERENCES destinations (code) ON UPDATE CASCADE ON DELETE RESTRICT,
+  type    text,                  -- sensible
+  obtenu  date,                  -- sensible
+  expire  date                   -- sensible
+);
+CREATE TABLE vaccinations (
+  id      integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id  integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  v       text,                  -- sensible (santé)
+  date    date                   -- sensible (santé)
+);
+CREATE TABLE inscriptions (
+  id          integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id      integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  session_id  integer NOT NULL REFERENCES sessions (id) ON DELETE CASCADE,
+  convoc      text,
+  date        date,
+  UNIQUE (emp_id, session_id)
+);
+CREATE TABLE plan_actions (
+  id        integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  exercice  integer NOT NULL,
+  f         text REFERENCES formations (id) ON UPDATE CASCADE ON DELETE RESTRICT,
+  libelle   text,
+  equipe    text NOT NULL REFERENCES equipes (nom) ON UPDATE CASCADE ON DELETE RESTRICT,
+  periode   text,
+  effectif  integer,
+  cout      numeric(12,2),
+  statut    text,
+  origine   text
+);
+CREATE TABLE budgets (
+  id        integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  exercice  integer NOT NULL,
+  equipe    text NOT NULL REFERENCES equipes (nom) ON UPDATE CASCADE ON DELETE CASCADE,
+  montant   numeric(12,2) NOT NULL DEFAULT 0,
+  UNIQUE (exercice, equipe)
+);
+
+-- ── Déplacements et données Keystone ────────────────────────────────────
+CREATE TABLE voyages (
+  id        integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id    integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  dest      text NOT NULL REFERENCES destinations (code) ON UPDATE CASCADE ON DELETE RESTRICT,
+  depart    date NOT NULL,
+  retour    date NOT NULL,
+  motif     text,
+  origine   text,
+  ref       text,
+  chantier  text REFERENCES chantiers (id) ON UPDATE CASCADE ON DELETE SET NULL
+);
+CREATE TABLE demandes_keystone (
+  id        integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id    integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  chantier  text NOT NULL REFERENCES chantiers (id) ON UPDATE CASCADE ON DELETE CASCADE,
+  dest      text NOT NULL REFERENCES destinations (code) ON UPDATE CASCADE ON DELETE RESTRICT,
+  depart    date NOT NULL,
+  retour    date NOT NULL,
+  recue     date
+);
+CREATE TABLE missions (
+  id      integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id  integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  projet  text NOT NULL REFERENCES projets (code) ON UPDATE CASCADE ON DELETE RESTRICT,
+  lieu    text,
+  du      date,
+  au      date,
+  type    text
+);
+CREATE TABLE taches (
+  id      integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id  integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  projet  text NOT NULL REFERENCES projets (code) ON UPDATE CASCADE ON DELETE RESTRICT,
+  tache   text,
+  heures  jsonb NOT NULL DEFAULT '[]' CHECK (jsonb_typeof(heures) = 'array')   -- 5 nombres (lun → ven)
+);
+
+-- ── Temps et congés ─────────────────────────────────────────────────────
+CREATE TABLE feuilles (
+  id        integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id    integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  week      date NOT NULL,       -- lundi de la semaine
+  statut    text NOT NULL,
+  comment   text,
+  sage      boolean NOT NULL DEFAULT false,
+  keystone  boolean NOT NULL DEFAULT false,
+  lignes    jsonb NOT NULL DEFAULT '[]' CHECK (jsonb_typeof(lignes) = 'array'),  -- [{projet, tache, ks, h[5]}]
+  contrat   jsonb,               -- régime figé à la soumission
+  UNIQUE (emp_id, week)
+);
+CREATE TABLE absences (
+  id        integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id    integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  type      text NOT NULL,
+  du        date NOT NULL,
+  au        date NOT NULL,
+  statut    text NOT NULL,
+  keystone  boolean NOT NULL DEFAULT false
+);
+CREATE TABLE cet (
+  id       integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id   integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  type     text NOT NULL,
+  jours    numeric NOT NULL,
+  date     date,
+  periode  text
+);
+CREATE TABLE reports (
+  id      integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id  integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  jours   numeric NOT NULL,
+  motif   text,
+  par     text,
+  date    date,
+  sens    text
+);
+
+-- ── Entretiens et demandes ──────────────────────────────────────────────
+CREATE TABLE entretiens (
+  id        integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id    integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  type      text NOT NULL,
+  date      date,
+  statut    text NOT NULL,
+  cr        jsonb NOT NULL DEFAULT '{}' CHECK (jsonb_typeof(cr) = 'object'),  -- sensible
+  info      boolean NOT NULL DEFAULT false,
+  sign_sal  date,
+  sign_mgr  date
+);
+CREATE TABLE demandes_collab (
+  id          integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  emp_id      integer NOT NULL REFERENCES employes (id) ON DELETE RESTRICT,
+  type        text NOT NULL,
+  f           text REFERENCES formations (id) ON UPDATE CASCADE ON DELETE RESTRICT,
+  h           text REFERENCES habilitations (id) ON UPDATE CASCADE ON DELETE RESTRICT,
+  libelle     text,
+  label       text,
+  session_id  integer REFERENCES sessions (id) ON DELETE SET NULL,
+  motif       text,
+  date        date,
+  statut      text NOT NULL,
+  reponse     text,
+  par_id      integer REFERENCES employes (id) ON DELETE RESTRICT
+);
+
+-- ── Système ─────────────────────────────────────────────────────────────
+CREATE TABLE settings (
+  key    text PRIMARY KEY,
+  value  jsonb
+);
+CREATE TABLE journal (
+  id       integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  at       timestamptz NOT NULL DEFAULT now(),
+  actor    text,
+  role     text,
+  action   text NOT NULL,
+  message  text,
+  payload  jsonb
+);
+
+-- ── Index sur les clés étrangères les plus lues (PostgreSQL n'indexe pas les FK) ──
+CREATE INDEX ON certifications (emp_id);
+CREATE INDEX ON hab_titres (emp_id);
+CREATE INDEX ON visas (emp_id);
+CREATE INDEX ON vaccinations (emp_id);
+CREATE INDEX ON voyages (emp_id);
+CREATE INDEX ON absences (emp_id);
+CREATE INDEX ON entretiens (emp_id);
+CREATE INDEX ON demandes_collab (emp_id);
+CREATE INDEX ON employes (equipe);
+CREATE INDEX ON plan_actions (equipe);
+
+-- ── Vue des heures validées (groupe D06, option A) : une ligne par feuille × projet ──
+CREATE VIEW heures_validees AS
+SELECT f.id AS feuille_id, f.emp_id, e.matricule, f.week AS semaine,
+       l->>'projet' AS projet, l->>'tache' AS tache,
+       (SELECT coalesce(sum(h::numeric), 0) FROM jsonb_array_elements_text(l->'h') AS h) AS heures,
+       f.keystone AS envoye_keystone, f.sage AS envoye_sage
+FROM feuilles f JOIN employes e ON e.id = f.emp_id CROSS JOIN LATERAL jsonb_array_elements(f.lignes) AS l
+WHERE f.statut = 'validee';
