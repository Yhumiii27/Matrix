# StarterPack EPC2I — copié en .env par installer.sh, qui génère les secrets vides. Jamais versionné, droits 600.

# ── Adresses des outils (DNS interne, ou /etc/hosts des postes) ───────────────────────────────────────────────────────
CLAVIS_HOST=clavis.epc2i.local
MATRIX_HOST=matrix.epc2i.local
KEYSTONE_HOST=keystone.epc2i.local
CODEX_HOST=codex.epc2i.local
# Certificats : « internal » (autorité locale de Caddy, à installer sur les postes) ou ceux de l'entreprise, copiés dans
# ./certs : EPC2I_TLS=/certs/fullchain.pem /certs/key.pem
EPC2I_TLS=internal
# Ports publiés par le proxy (80 et 443 par défaut).
# EPC2I_HTTP_PORT=80
# EPC2I_HTTPS_PORT=443

# ── Sources des outils : dossier qui contient Matrix, Clavis, Keystone et Codex (par défaut ../../..) ─────────────────
# EPC2I_SOURCES=/opt/epc2i

# ── Accès de démonstration à Keystone et Codex (jalon A, authentification HTTP du proxy) ──────────────────────────────
ACCES_DEMO_UTILISATEUR=epc2i
ACCES_DEMO_MOT_DE_PASSE=

# ── Jeux de données au premier démarrage : demo (jalon A) ou production / minimal (base propre, jalon C) ─────────────
# KEYSTONE_SEED=demo
# CODEX_SEED=demo

# ── Secrets : laissés vides, installer.sh les génère ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
KEYSTONE_APP_PASSWORD=
CODEX_APP_PASSWORD=
CURSUS_APP_PASSWORD=
VIGIE_APP_PASSWORD=
ARCHE_APP_PASSWORD=
CRUCIBLE_APP_PASSWORD=
CLAVIS_APP_PASSWORD=
MATRIX_APP_PASSWORD=
MATRIX_GESTION_PASSWORD=
EPC2I_SAUVEGARDE_PASSWORD=
MATRIX_TOKEN=
MATRIX_MOT_DE_PASSE=
MATRIX_SESSION_SECRET=
CLAVIS_SESSION_SECRET=

# Rétention des sauvegardes du serveur commun, en jours.
# EPC2I_SAUVEGARDE_JOURS=14
