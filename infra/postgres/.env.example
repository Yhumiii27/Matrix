# Variables du serveur PostgreSQL commun EPC2I (docker-compose.yml).
# En local : copier ce fichier en .env (jamais versionné) et remplir chaque valeur.
# Dans Coolify : saisir les mêmes variables dans la ressource.
# Un mot de passe solide : openssl rand -base64 30 | tr -d '/+=' | cut -c1-32

# Superutilisateur postgres (administration seulement).
POSTGRES_PASSWORD=

# Rôles de connexion des outils (init/01-base-et-roles.sql). Chaque outil reçoit le sien dans DATABASE_URL.
KEYSTONE_APP_PASSWORD=
CODEX_APP_PASSWORD=
CURSUS_APP_PASSWORD=
VIGIE_APP_PASSWORD=
ARCHE_APP_PASSWORD=
CRUCIBLE_APP_PASSWORD=
MATRIX_APP_PASSWORD=

# Rôle des sauvegardes (pg_dump, lecture de toutes les données, colonnes sensibles comprises).
EPC2I_SAUVEGARDE_PASSWORD=

# Facultatif : port local publié (127.0.0.1) et rétention des sauvegardes en jours.
# EPC2I_PG_PORT=5432
# EPC2I_SAUVEGARDE_JOURS=14
